{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jobby": {
    "UseMetrics": true,
    "UseTracing": false,
    "SeedDashboardDemoData": false,
    "Server": {
      "PollingIntervalMs": 500,
      "MaxDegreeOfParallelism": 10,
      "TakeToProcessingBatchSize": 10,
      "DeleteCompleted": true,
      "CompleteWithBatching": false,
      "HeartbeatIntervalSeconds": 10,
      "MaxNoHeartbeatIntervalSeconds": 600,
      "PermanentLockedFreezingIntervalSeconds": 15,
      "PermanentLockedHandleUnlockingRequestsIntervalSeconds": 10,
      "DbErrorPauseMs": 5000
    },
    "Queues": [
      { "QueueName": "default" },
      { "QueueName": "recurrent" },
      { "QueueName": "heavy", "MaxDegreeOfParallelism": 1 }
    ]
  }
}
