@page "/"
@inherits LocalizedComponentBase
@inject DashboardApiClient Reader
@inject DashboardClientConfig Options
@inject DateTimeDisplayState Dt
@inject NavigationManager Nav

<PageHeader Title="@L["nav.overview"]">
    <Actions>
        <AutoRefresh OnRefresh="LoadAsync" Interval="Options.RefreshInterval"/>
    </Actions>
</PageHeader>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-5" data-testid="overview-error">@_error</MudAlert>
}

@if (_loading && _stats is null)
{
    <div class="jobby-status-tiles" data-testid="overview-loading">
        @for (var i = 0; i < 6; i++)
        {
            <MudPaper Outlined="true" Class="pa-3">
                <MudSkeleton Width="80px" Height="22px"/>
                <MudSkeleton Width="48px" Height="34px" Class="mt-3"/>
            </MudPaper>
        }
    </div>
}
else if (_stats is not null)
{
    <div class="d-flex align-baseline justify-space-between gap-3 mb-2">
        <div class="jobby-panel-title">@L["nav.jobs"]</div>
        <div class="jobby-text-xs" style="color:var(--text-3);"
             data-testid="overview-total">@L.Format("overview.totalJobs", _stats.Total)</div>
    </div>
    <div class="jobby-status-tiles" data-testid="overview-cards">
        @foreach (var status in TileOrder)
        {
            <StatusTile Status="status" Count="CountFor(status)" Href="@JobsHref(status)"
                        TestId="@($"tile-{status}")" CountTestId="@($"count-{status}")"/>
        }
    </div>

    <div class="jobby-panel-title mt-5 mb-2">@L["overview.recurrentJobs"]</div>
    <div class="jobby-status-tiles" data-testid="overview-recurrent">
        @foreach (var status in RecurrentStatuses)
        {
            <StatusTile Status="status" Count="RecurrentCountFor(status)" Href="recurrent"
                        TestId="@($"recurrent-tile-{status}")" CountTestId="@($"recurrent-count-{status}")"/>
        }
    </div>

    <MudGrid Class="mt-4" Spacing="3">
        <MudItem xs="12" md="4">
            <MudPaper Outlined="true" Class="pa-4" Style="height:100%;">
                <div class="jobby-panel-title mb-3">@L["nav.queues"]</div>
                <div data-testid="overview-queues">
                    @if (_queues.Count == 0)
                    {
                        <EmptyState Title="@L["empty.noQueues"]" Icon="@Icons.Material.Filled.Layers"
                                    TestId="overview-queues-empty"/>
                    }
                    else
                    {
                        @foreach (var q in _queues)
                        {
                            var total = q.StatusCounts.Sum(s => s.Count);
                            <a href="@QueueHref(q.QueueName)" class="jobby-row-link d-flex flex-column"
                               style="padding:7px 0;" data-testid="@($"overview-queue-{q.QueueName}")">
                                <div class="d-flex align-center justify-space-between gap-3">
                                    <span style="color:var(--text-1);font-size:13px;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"
                                          title="@q.QueueName">@q.QueueName</span>
                                    <span class="jobby-text-xs" style="color:var(--text-3);white-space:nowrap;">
                                        @L["queues.backlog"]
                                        <span class="jobby-mono" style="font-size:13px;color:var(--text-1);"
                                              data-testid="@($"overview-queue-backlog-{q.QueueName}")">@QueueBacklog.Count(q.StatusCounts)</span>
                                        <span class="mx-1">/</span>
                                        @L["queues.total"]
                                        <span class="jobby-mono" style="font-size:13px;color:var(--text-2);"
                                              data-testid="@($"overview-queue-total-{q.QueueName}")">@total</span>
                                    </span>
                                </div>
                                <div class="mt-2">
                                    <StackedStatusBar Counts="q.StatusCounts"/>
                                </div>
                            </a>
                        }
                    }
                </div>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudPaper Outlined="true" Class="pa-4" Style="height:100%;">
                <div class="jobby-panel-title mb-3">@L["overview.serverHealth"]</div>
                <div data-testid="overview-servers">
                    @if (_servers.Count == 0)
                    {
                        <EmptyState Title="@L["empty.noServersReporting"]" Icon="@Icons.Material.Filled.Dns"
                                    TestId="overview-servers-empty"/>
                    }
                    else
                    {
                        @foreach (var s in _servers)
                        {
                            var alive = s.HeartbeatTs >= _threshold;
                            <div class="d-flex align-center gap-3" style="padding:7px 0;">
                                <span
                                    style="width:8px;height:8px;border-radius:50%;flex-shrink:0;background:@(alive ? "var(--st-alive)" : "var(--st-stale)");"></span>
                                <div class="flex-grow-1" style="min-width:0;">
                                    <div class="jobby-mono jobby-text-xs"
                                         style="color:var(--text-1);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"
                                         title="@s.Id">@s.Id</div>
                                    <div class="jobby-text-xs" style="color:var(--text-3);"
                                         title="@Dt.FormatAbsolute(s.HeartbeatTs)">@L.Relative(s.HeartbeatTs, allowFuture: false)</div>
                                </div>
                                <ServerStateChip Alive="alive"/>
                            </div>
                        }
                    }
                </div>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudPaper Outlined="true" Class="pa-4" Style="height:100%;">
                <div class="jobby-panel-title mb-3">@L["overview.needsAttention"]</div>
                <div data-testid="overview-attention">
                    @{
                        var failed = CountFor(JobStatus.Failed);
                        var frozen = CountFor(JobStatus.Frozen);
                    }
                    @if (_lockedGroups == 0 && failed == 0 && frozen == 0)
                    {
                        <EmptyState Title="@L["overview.nothingNeedsAttention"]"
                                    Icon="@Icons.Material.Filled.CheckCircle"
                                    TestId="overview-attention-empty"/>
                    }
                    else
                    {
                        @if (_lockedGroups > 0)
                        {
                            <a href="locked-groups" class="jobby-row-link d-flex align-center gap-3"
                               style="padding:7px 0;" data-testid="overview-attention-locked">
                                <span class="jobby-tile-icon"
                                      style="background:var(--st-failed-bg);color:var(--st-failed);">
                                    <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small"/>
                                </span>
                                <div class="flex-grow-1" style="min-width:0;">
                                    <div style="color:var(--text-1);font-size:13px;">@L["nav.lockedGroups"]</div>
                                    <div class="jobby-text-xs" style="color:var(--text-3);"
                                         data-testid="overview-attention-locked-count">@L.Format("overview.lockedGroupsWaiting", _lockedGroups)</div>
                                </div>
                            </a>
                        }

                        @if (failed > 0)
                        {
                            <a href="@JobsHref(JobStatus.Failed)" class="jobby-row-link d-flex align-center gap-3"
                               style="padding:7px 0;" data-testid="overview-attention-failed">
                                <span class="jobby-tile-icon"
                                      style="background:var(--st-failed-bg);color:var(--st-failed);">
                                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Small"/>
                                </span>
                                <div class="flex-grow-1" style="min-width:0;">
                                    <div style="color:var(--text-1);font-size:13px;">@L["overview.failedJobs"]</div>
                                    <div class="jobby-text-xs"
                                         style="color:var(--text-3);">@L.Format("overview.acrossAllQueues", failed)</div>
                                </div>
                                <StatusChip Status="JobStatus.Failed"/>
                            </a>
                        }

                        @if (frozen > 0)
                        {
                            <a href="@JobsHref(JobStatus.Frozen)" class="jobby-row-link d-flex align-center gap-3"
                               style="padding:7px 0;" data-testid="overview-attention-frozen">
                                <span class="jobby-tile-icon"
                                      style="background:var(--st-frozen-bg);color:var(--st-frozen);">
                                    <MudIcon Icon="@Icons.Material.Filled.AcUnit" Size="Size.Small"/>
                                </span>
                                <div class="flex-grow-1" style="min-width:0;">
                                    <div style="color:var(--text-1);font-size:13px;">@L["overview.frozenJobs"]</div>
                                    <div class="jobby-text-xs"
                                         style="color:var(--text-3);">@L.Format("overview.acrossAllQueues", frozen)</div>
                                </div>
                                <StatusChip Status="JobStatus.Frozen"/>
                            </a>
                        }
                    }
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {

    private static readonly JobStatus[] TileOrder =
    [
        JobStatus.Scheduled, JobStatus.Processing, JobStatus.Completed,
        JobStatus.Failed, JobStatus.Frozen, JobStatus.WaitingPrev,
    ];

    private static readonly JobStatus[] RecurrentStatuses = [JobStatus.Scheduled, JobStatus.Processing];

    private DashboardStatsDto? _stats;
    private IReadOnlyList<DashboardServerDto> _servers = [];
    private IReadOnlyList<DashboardQueueDto> _queues = [];
    private long _lockedGroups;
    private DateTime _threshold;
    private bool _loading;
    private string? _error;
    private readonly CancellationTokenSource _cts = new();

    private long CountFor(JobStatus status) =>
        _stats?.StatusCounts.FirstOrDefault(c => c.Status == status)?.Count ?? 0;

    private long RecurrentCountFor(JobStatus status) =>
        _stats?.RecurrentStatusCounts.FirstOrDefault(c => c.Status == status)?.Count ?? 0;

    private string QueueHref(string queueName) =>
        Nav.GetUriWithQueryParameters("queue", new Dictionary<string, object?> { ["name"] = queueName });

    private static string JobsHref(JobStatus status) => $"jobs?status={status}";

    protected override Task OnInitializedAsync()
    {
        Dt.Changed += OnDisplayChanged;
        return LoadAsync();
    }

    private void OnDisplayChanged() => InvokeAsync(StateHasChanged);

    private async Task LoadAsync()
    {
        if (_loading)
        {
            return;
        }

        try
        {
            _loading = true;
            _error = null;

            var statsTask = Reader.GetStatsAsync(_cts.Token);
            var serversTask = Reader.GetServersAsync(_cts.Token);
            var queuesTask = Reader.GetQueuesAsync(_cts.Token);
            var lockedGroupsTask = Reader.GetLockedGroupsCountAsync(_cts.Token);
            await Task.WhenAll(statsTask, serversTask, queuesTask, lockedGroupsTask);

            _stats = await statsTask;
            _servers = await serversTask;
            _queues = await queuesTask;
            _lockedGroups = await lockedGroupsTask;
            _threshold = Options.ServerUtcNow.AddSeconds(-Options.StaleServerThresholdSeconds);
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception)
        {
            _error = L["overview.loadError"];
        }
        finally
        {
            _loading = false;
        }
    }

    public override void Dispose()
    {
        base.Dispose();
        Dt.Changed -= OnDisplayChanged;
        _cts.Cancel();
        _cts.Dispose();
    }

}
